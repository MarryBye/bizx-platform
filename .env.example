# ================= DOCKER & DATABASE (PostgreSQL / Drizzle) =================
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="bizx_db"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bizx_db"

# ================= REDIS & BULLMQ QUEUES =================
REDIS_URL="redis://localhost:6379"

# ================= CLOUDFLARE R2 (S3-Compatible Storage) =================
CLOUDFLARE_R2_ACCOUNT_ID="your_account_id"
CLOUDFLARE_R2_ACCESS_KEY_ID="your_r2_access_key"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="your_r2_secret_key"
CLOUDFLARE_R2_BUCKET_NAME="bizx-assets"
CLOUDFLARE_R2_PUBLIC_DOMAIN="https://assets.bizx.io"

# ================= APPS PORTS =================
PORT=3101
NEXT_PUBLIC_API_URL="http://localhost:3101"
VITE_API_URL="http://localhost:3101"
EXPO_PUBLIC_API_URL="http://localhost:3101"
