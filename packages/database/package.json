{
  "name": "@bizx/database",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schema": {
      "types": "./src/schema/index.ts",
      "default": "./src/schema/index.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@bizx/eslint-config": "workspace:*",
    "@bizx/typescript-config": "workspace:*",
    "@types/node": "^22.13.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.21.0",
    "typescript": "^5.7.3"
  }
}
