{
  "name": "bizx-platform",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "dev:api": "turbo run dev --filter=@bizx/api",
    "dev:landing": "turbo run dev --filter=@bizx/landing",
    "dev:admin": "turbo run dev --filter=@bizx/admin",
    "dev:mobile": "pnpm --filter @bizx/mobile start",
    "build:api": "turbo run build --filter=@bizx/api",
    "build:landing": "turbo run build --filter=@bizx/landing",
    "build:admin": "turbo run build --filter=@bizx/admin",
    "start:api": "pnpm --filter @bizx/api start",
    "db:generate": "pnpm --filter @bizx/database db:generate",
    "db:migrate": "pnpm --filter @bizx/database db:migrate",
    "db:push": "pnpm --filter @bizx/database db:push",
    "db:studio": "pnpm --filter @bizx/database db:studio",
    "docker:db": "docker compose up -d postgres redis",
    "docker:up": "docker compose up -d",
    "docker:build": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "eslint": "^9.21.0",
    "prettier": "^3.5.1",
    "turbo": "^2.11.7",
    "typescript": "^5.7.3"
  }
}
